# Copy this file to .env for local use (never commit .env).
# On Netlify, add the same names under Site settings → Environment variables.

# OAuth client for your Google Cloud project (Web application type).
# Used for "Sign in with Google" and for the app to edit the sheet as your Google account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your existing Google Sheet: the long code in its URL, between /d/ and /edit.
# Leave empty to have scripts/authorize.js create a new "Karaoke-App-Annie-<date time>" sheet.
SHEET_ID=

# Filled in automatically by: node scripts/authorize.js
GOOGLE_REFRESH_TOKEN=

# Random secret that signs login sessions (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Time zone for timestamps, e.g. America/Los_Angeles, America/Chicago, America/New_York
TIME_ZONE=America/Los_Angeles
